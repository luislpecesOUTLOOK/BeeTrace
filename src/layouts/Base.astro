---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14110d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #14110d;
    --card: #1e1912;
    --cream: #f5efe3;
    --muted: #c9bfad;
    --faint: #a99f8c;
    --accent: #f2a81d;
    --ok: #9be09b;
    --band: #1a1610;
    --line: rgba(245, 239, 227, 0.08);
    --display: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* The comb and the amber glow sit behind the header and hero; later
     sections paint their own opaque background over them. */
  body {
    margin: 0;
    background:
      radial-gradient(55% 55% at 78% 45%, rgba(242, 168, 29, 0.16), rgba(242, 168, 29, 0)) top / 100% max(860px, 100svh) no-repeat,
      url('/comb.svg') 0 0 / 61.6px 106.7px,
      var(--ink);
    color: var(--cream);
    font-family: var(--display);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--cream);
  }

  a:hover {
    color: var(--accent);
  }

  section[id] {
    scroll-margin-top: 24px;
  }

  .skip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
