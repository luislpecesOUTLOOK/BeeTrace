---
import App from '../../layouts/App.astro';
---

<App title="Ficha de lote · BeeTrace">
  <div id="lote-root"></div>
  <div class="nav-row">
    <a class="ghost" id="back-link" href="/app/">Volver</a>
    <button class="ghost" id="btn-json" type="button">Exportar ficha (JSON)</button>
    <button class="ghost" id="btn-print" type="button">Imprimir ficha / QR</button>
  </div>
</App>

<script>
  import QRCode from 'qrcode';
  import {
    getLot,
    getProfile,
    listAnalyses,
    listMovements,
    listReceptions,
    type LotRec,
  } from '../../lib/store';
  import { blendComposition, qrPayloadFor } from '../../lib/trace';
  import { field } from '../../lib/app-ui';

  const root = field('lote-root');
  const params = new URLSearchParams(location.search);
  const id = (params.get('id') ?? '').toUpperCase();
  const profile = getProfile();
  if (!profile) location.href = '/app/';
  if (!id) location.href = '/app/';

  const back = document.getElementById('back-link') as HTMLAnchorElement;
  if (profile) back.href = profile.role === 'apicultor' ? '/app/apicultor' : '/app/envasadora';

  const lot = getLot(id);
  if (!lot) {
    root.innerHTML =
      `<h1>Lote ${id}</h1>` +
      '<p class="flash" data-kind="error">Ese lote no existe en este dispositivo.</p>' +
      (profile?.role === 'apicultor'
        ? `<a class="primary" href="/app/apicultor?crear=${encodeURIComponent(id)}">Crear este lote</a>`
        : '<p class="hint">Pide al apicultor el QR del lote o revisa el identificador.</p>');
  } else {
    render(lot);
  }

  function dl(label: string): string {
    return lot && (lot as LotRec).kind === 'mezcla' && label === 'Origen' ? 'Composición' : label;
  }

  async function render(l: LotRec): Promise<void> {
    const demo = l.demo ? ' <span class="demo-tag">· datos de demostración</span>' : '';
    const comp =
      l.kind === 'mezcla'
        ? blendComposition(l.origins, (x) => getLot(x)?.country ?? '?')
        : [];
    const recs = listReceptions(l.id);
    const anas = listAnalyses(l.id);
    const movs = listMovements(50).filter(
      (m) => m.action.includes(l.id) || m.detail.includes(l.id),
    );

    root.innerHTML =
      `<h1>Lote ${l.id}${demo}</h1>` +
      `<p class="kind">${l.kind === 'mezcla' ? 'Lote de mezcla' : 'Lote de origen'} · estado: ${l.receptionStatus}</p>` +
      '<div class="qr-box"><canvas id="qr-main" width="220" height="220"></canvas>' +
      `<div><p class="hint">QR del lote. Imprímelo y pégalo en los bidones.</p><button class="ghost" id="btn-qr" type="button">Descargar QR (PNG)</button></div></div>` +
      '<dl class="ficha">' +
      row('Apicultor / responsable', l.beekeeper) +
      row(dl('Origen'), l.kind === 'mezcla' ? comp.map((c) => `${c.country}: ${c.pct}%`).join(' · ') || '—' : `${l.farm} · ${l.country} · ${l.location}`) +
      row('Cosecha / extracción', `${l.harvestDate} / ${l.extractionDate}`) +
      row('Tipo de miel', l.honeyType) +
      row('Cantidad', `${l.totalKg} kg (disponibles: ${l.availableKg} kg)`) +
      row('Destinataria / envío', l.destCompany ? `${l.destCompany} · ${l.shipDate || 'sin fecha'}` : '—') +
      row('Documentación', l.docs.length ? l.docs.map((d) => d.name).join(', ') : '—') +
      '</dl>' +
      '<h2>Bidones</h2><ul class="card-list">' +
      l.drums.map((d) => `<li class="lot-card"><strong>${d.id}</strong><span>${d.weightKg} kg</span></li>`).join('') +
      '</ul>' +
      (l.origins.length
        ? '<h2>Trazabilidad de la mezcla</h2><ul class="card-list">' +
          l.origins.map((o) => `<li class="lot-card"><strong>${o.lotId}</strong><span>${o.kg} kg aportados</span></li>`).join('') +
          '</ul>'
        : '') +
      '<h2>Recepciones</h2>' +
      (recs.length
        ? '<ul class="card-list">' + recs.map((r) => `<li class="lot-card"><strong>${r.date} · ${r.kgReceived} kg</strong><span>${r.responsible} · ${r.status}</span><span>${r.notes}</span></li>`).join('') + '</ul>'
        : '<p class="hint">Sin recepciones registradas.</p>') +
      '<h2>Análisis</h2>' +
      (anas.length
        ? '<ul class="card-list">' +
          anas.map((a) => `<li class="lot-card"><strong>${a.param}: ${a.value}${a.unit ? ' ' + a.unit : ''}</strong><span>${a.method} · ${a.screening ? 'cribado' : 'confirmatorio'} · ${a.date}</span><span>Muestra ${a.sample || '—'} · ${a.lab || '—'} · ${a.responsible || '—'}${a.reportName ? ' · ' + a.reportName : ''}</span></li>`).join('') +
          '</ul>'
        : '<p class="hint">Sin análisis registrados. Los valores aquí mostrados son los introducidos a mano, no mediciones del teléfono.</p>') +
      '<h2>Movimientos</h2>' +
      (movs.length
        ? '<ul class="card-list">' + movs.map((m) => `<li class="lot-card"><strong>${m.action}</strong><span>${m.actor} · ${new Date(m.at).toLocaleString('es')}</span><span>${m.detail}</span></li>`).join('') + '</ul>'
        : '<p class="hint">Sin movimientos.</p>') +
      '<p class="hint legal">Ficha informativa: distingue datos declarados por el productor de los comprobados con documentos o análisis. No es una certificación de cumplimiento normativo.</p>';

    const canvas = document.getElementById('qr-main') as HTMLCanvasElement;
    await QRCode.toCanvas(canvas, qrPayloadFor(l.id), { width: 220, margin: 2 });

    (document.getElementById('btn-qr') as HTMLButtonElement).addEventListener('click', () => {
      const a = document.createElement('a');
      a.download = `QR-${l.id}.png`;
      a.href = canvas.toDataURL('image/png');
      a.click();
    });
  }

  function row(k: string, v: string): string {
    return `<div><dt>${k}</dt><dd>${v}</dd></div>`;
  }

  document.getElementById('btn-print')?.addEventListener('click', () => window.print());
  document.getElementById('btn-json')?.addEventListener('click', () => {
    const l = getLot(id);
    if (!l) return;
    const blob = new Blob(
      [JSON.stringify({ lote: l, recepciones: listReceptions(id), analisis: listAnalyses(id) }, null, 2)],
      { type: 'application/json' },
    );
    const a = document.createElement('a');
    a.download = `ficha-${id}.json`;
    a.href = URL.createObjectURL(blob);
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>

<style>
  .kind {
    color: var(--muted);
  }

  .qr-box {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
  }

  .qr-box canvas {
    width: 160px;
    height: 160px;
    border-radius: 8px;
    background: #fff;
  }

  .hint {
    color: var(--muted);
    font-size: 15px;
  }

  .legal {
    font-size: 13px;
  }

  .ficha {
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .ficha div {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 12px;
    padding: 12px 16px;
    background: var(--card);
  }

  .ficha div + div {
    border-top: 1px solid var(--line);
  }

  .ficha dt {
    color: var(--faint);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ficha dd {
    margin: 0;
  }

  @media (max-width: 520px) {
    .ficha div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .nav-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  @media print {
    .nav-row,
    .top,
    .notice {
      display: none;
    }
  }
</style>
