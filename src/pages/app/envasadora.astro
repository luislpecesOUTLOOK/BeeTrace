---
import App from '../../layouts/App.astro';
---

<App title="Envasadora · BeeTrace">
  <div class="who">
    <h1>Envasadora</h1>
    <p id="who-line" class="who-line"></p>
    <div class="who-actions">
      <a class="ghost" href="/#escanear">Escanear QR</a>
      <button class="ghost" id="btn-out" type="button">Salir</button>
    </div>
  </div>

  <h2>1 · Recepción</h2>
  <form id="rec-form">
    <label>
      Lote o bidón escaneado
      <input id="r-lot" required placeholder="BT-26-0412" />
    </label>
    <div id="r-origin" class="origin" hidden></div>
    <div class="grid">
      <label>
        Fecha de recepción
        <input id="r-date" type="date" required />
      </label>
      <label>
        Cantidad recibida (kg)
        <input id="r-kg" type="number" min="0.1" step="0.1" required />
      </label>
    </div>
    <label>
      Responsable
      <input id="r-resp" required />
    </label>
    <label>
      Muestras y controles asociados
      <input id="r-samples" placeholder="M-0412-A, M-0412-B" />
    </label>
    <label>
      Observaciones
      <textarea id="r-notes"></textarea>
    </label>
    <label>
      Estado
      <select id="r-status">
        <option value="pendiente-analisis">Pendiente de análisis</option>
        <option value="aceptado">Aceptado</option>
        <option value="rechazado">Rechazado</option>
      </select>
    </label>
    <button class="primary" id="btn-rec" type="submit">Confirmar recepción</button>
  </form>

  <h2>2 · Mezclas</h2>
  <p class="hint">
    Selecciona lotes de origen y los kilos de cada uno. El stock se descuenta al
    confirmar. La operación es única aunque pulses dos veces.
  </p>
  <form id="blend-form">
    <div id="blend-origins" class="origins"></div>
    <label>
      Bidón o depósito de la mezcla
      <input id="b-drum" required placeholder="DEP-01" />
    </label>
    <div id="b-summary" class="origin" hidden></div>
    <button class="primary" id="btn-blend" type="submit">Confirmar mezcla</button>
  </form>

  <h2>3 · Control de calidad</h2>
  <p class="hint">
    Registra resultados reales introducidos o importados a mano. Esta app no mide
    la miel con la cámara: distingue cribado de confirmatorio.
  </p>
  <form id="ana-form">
    <div class="grid">
      <label>
        Lote
        <input id="a-lot" required placeholder="BT-26-0412" />
      </label>
      <label>
        Fecha
        <input id="a-date" type="date" required />
      </label>
    </div>
    <div class="grid">
      <label>
        Parámetro
        <input id="a-param" required list="params" placeholder="Humedad" />
      </label>
      <label>
        Valor o conclusión
        <input id="a-value" required placeholder="17,8 / Negativo" />
      </label>
    </div>
    <div class="grid">
      <label>
        Unidad
        <input id="a-unit" placeholder="%, mg/kg…" />
      </label>
      <label>
        Método
        <input id="a-method" required list="methods" placeholder="NIR" />
      </label>
    </div>
    <datalist id="params">
      <option value="Humedad"></option>
      <option value="Azúcares"></option>
      <option value="HMF"></option>
      <option value="Perfil polínico"></option>
      <option value="Adulteración / jarabes"></option>
    </datalist>
    <datalist id="methods">
      <option value="NIR"></option>
      <option value="FTIR"></option>
      <option value="RMN"></option>
      <option value="Kit portátil"></option>
      <option value="Laboratorio externo"></option>
    </datalist>
    <label class="check">
      <input id="a-screen" type="checkbox" checked /> Es prueba de cribado (no confirmatoria)
    </label>
    <div class="grid">
      <label>
        Muestra
        <input id="a-sample" placeholder="M-0412-A" />
      </label>
      <label>
        Equipo o laboratorio
        <input id="a-lab" placeholder="Lab. interno / Eurofins" />
      </label>
    </div>
    <label>
      Responsable
      <input id="a-resp" />
    </label>
    <label>
      Informe adjunto (nombre de archivo)
      <input id="a-report" placeholder="informe-0412.pdf" />
    </label>
    <button class="primary" id="btn-ana" type="submit">Guardar análisis</button>
  </form>

  <h2>Historial</h2>
  <ul class="card-list" id="mov-list"></ul>
</App>

<script>
  import {
    addAnalysis,
    confirmBlend,
    getLot,
    listLots,
    listMovements,
    listReceptions,
    registerReception,
    type Profile,
  } from '../../lib/store';
  import { blendComposition } from '../../lib/trace';
  import { flash, num, requireProfile, signOut, today, val, field } from '../../lib/app-ui';

  const profile = requireProfile('envasadora') as Profile | null;
  if (profile) {
    field('who-line').textContent = `${profile.name} · ${profile.org}`;
    (document.getElementById('r-resp') as HTMLInputElement).value = profile.name;
    (document.getElementById('r-date') as HTMLInputElement).value = today();
    (document.getElementById('a-resp') as HTMLInputElement).value = profile.name;
    (document.getElementById('a-date') as HTMLInputElement).value = today();

    const preset = new URLSearchParams(location.search).get('id');
    if (preset) {
      (document.getElementById('r-lot') as HTMLInputElement).value = preset.toUpperCase();
      showOrigin(preset.toUpperCase());
    }
    renderBlendOrigins();
    renderMovements();
  }

  field('btn-out').addEventListener('click', signOut);

  /* ---- reception ---- */

  field('r-lot').addEventListener('change', (e) => {
    showOrigin((e.target as HTMLInputElement).value.toUpperCase());
  });

  function showOrigin(id: string): void {
    const box = field('r-origin');
    const lot = getLot(id);
    if (!lot) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    const recs = listReceptions(id);
    box.innerHTML =
      `<strong>${lot.id}</strong> · ${lot.honeyType}, ${lot.country} (${lot.farm}). ` +
      `Enviados: ${lot.totalKg} kg. Estado: ${lot.receptionStatus}. ` +
      (recs.length > 0 ? '⚠️ Ya tiene recepción registrada: se bloqueará el duplicado.' : 'Sin recepción previa.');
  }

  field('rec-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!profile) return;
    const btn = field<HTMLButtonElement>('btn-rec');
    btn.disabled = true;
    try {
      const rec = registerReception(
        {
          lotId: val('r-lot'),
          date: val('r-date'),
          kgReceived: num('r-kg'),
          responsible: val('r-resp'),
          notes: val('r-notes'),
          samples: val('r-samples'),
          status: val('r-status') as 'pendiente-analisis' | 'aceptado' | 'rechazado',
        },
        profile,
      );
      const lot = getLot(rec.lotId);
      const diff = lot ? Math.round((rec.kgReceived - lot.totalKg) * 100) / 100 : 0;
      flash(
        'ok',
        `Recepción de ${rec.lotId} guardada: ${rec.kgReceived} kg (diferencia con enviados: ${diff >= 0 ? '+' : ''}${diff} kg).`,
      );
      renderMovements();
    } catch (err) {
      flash('error', err instanceof Error ? err.message : 'No se pudo guardar la recepción.');
    } finally {
      btn.disabled = false;
    }
  });

  /* ---- blends ---- */

  function renderBlendOrigins(): void {
    const box = field('blend-origins');
    box.innerHTML = '';
    const lots = listLots().filter((l) => l.availableKg > 0);
    if (lots.length === 0) {
      box.innerHTML = '<p class="hint">No hay lotes con stock disponible.</p>';
      return;
    }
    for (const l of lots) {
      const row = document.createElement('div');
      row.className = 'blend-row';
      row.innerHTML =
        `<label class="check"><input type="checkbox" value="${l.id}" /> ${l.id} · ${l.country} · stock ${l.availableKg} kg</label>` +
        '<input type="number" min="0.1" step="0.1" placeholder="kg" aria-label="Kilos de ' +
        l.id +
        '" />';
      box.append(row);
    }
    box.addEventListener('input', showBlendSummary);
    box.addEventListener('change', showBlendSummary);
  }

  function readUses(): { lotId: string; kg: number }[] {
    const uses: { lotId: string; kg: number }[] = [];
    for (const row of document.querySelectorAll('.blend-row')) {
      const check = row.querySelector('input[type=checkbox]') as HTMLInputElement;
      const kg = row.querySelector('input[type=number]') as HTMLInputElement;
      if (check.checked) uses.push({ lotId: check.value, kg: Number(kg.value.replace(',', '.')) });
    }
    return uses;
  }

  function showBlendSummary(): void {
    const box = field('b-summary');
    const uses = readUses();
    if (uses.length === 0) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    const comp = blendComposition(
      uses.filter((u) => u.kg > 0),
      (id) => getLot(id)?.country ?? '?',
    );
    const total = comp.reduce((a, c) => a + c.kg, 0);
    box.innerHTML =
      `<strong>Resumen:</strong> ${Math.round(total * 100) / 100} kg. ` +
      (comp.map((c) => `${c.country} ${c.pct}%`).join(' · ') || 'Revisa las cantidades.');
  }

  const blendIdemKey =
    typeof crypto !== 'undefined' && 'randomUUID' in crypto ? crypto.randomUUID() : String(Date.now());

  field('blend-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!profile) return;
    const btn = field<HTMLButtonElement>('btn-blend');
    btn.disabled = true;
    try {
      const { lot, totalKg } = confirmBlend(
        { uses: readUses(), drumId: val('b-drum'), responsible: profile.name, idemKey: blendIdemKey },
        profile,
      );
      flash('ok', `Mezcla ${lot.id} confirmada: ${totalKg} kg.`);
      location.href = `/app/lote?id=${encodeURIComponent(lot.id)}`;
    } catch (err) {
      flash('error', err instanceof Error ? err.message : 'No se pudo confirmar la mezcla.');
      btn.disabled = false;
    }
  });

  /* ---- analyses ---- */

  field('ana-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!profile) return;
    const btn = field<HTMLButtonElement>('btn-ana');
    btn.disabled = true;
    try {
      const rec = addAnalysis(
        {
          lotId: val('a-lot'),
          param: val('a-param'),
          value: val('a-value'),
          unit: val('a-unit'),
          method: val('a-method'),
          screening: (document.getElementById('a-screen') as HTMLInputElement).checked,
          date: val('a-date'),
          sample: val('a-sample'),
          lab: val('a-lab'),
          responsible: val('a-resp'),
          reportName: val('a-report'),
        },
        profile,
      );
      flash('ok', `Análisis guardado en ${rec.lotId}: ${rec.param} (${rec.method}).`);
      renderMovements();
    } catch (err) {
      flash('error', err instanceof Error ? err.message : 'No se pudo guardar el análisis.');
    } finally {
      btn.disabled = false;
    }
  });

  function renderMovements(): void {
    const ul = field('mov-list');
    ul.innerHTML = '';
    for (const m of listMovements(20)) {
      const li = document.createElement('li');
      li.className = 'lot-card';
      li.innerHTML =
        `<strong>${m.action}</strong><span>${m.actor} · ${new Date(m.at).toLocaleString('es')}</span><span>${m.detail}</span>`;
      ul.append(li);
    }
  }
</script>

<style>
  .who-line {
    color: var(--muted);
    margin: 4px 0 12px;
  }

  .who-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
  }

  .hint {
    color: var(--muted);
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .origin {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--card);
    border: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
  }

  .origins {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .blend-row {
    display: grid;
    grid-template-columns: 1fr 110px;
    gap: 8px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .check {
    flex-direction: row !important;
    align-items: center;
    gap: 10px !important;
  }

  .check input[type='checkbox'] {
    width: 26px;
    height: 26px;
    min-height: 0;
    accent-color: var(--accent);
  }
</style>
