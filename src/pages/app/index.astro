---
import App from '../../layouts/App.astro';
---

<App title="Entrar · BeeTrace">
  <h1>Entra para continuar</h1>
  <p class="sub">
    Elige tu perfil. En esta vista previa el acceso es local a este dispositivo:
    no hay contraseñas ni permisos de servidor todavía.
  </p>

  <form id="enter-form">
    <label>
      Perfil
      <select id="f-rol" required>
        <option value="apicultor">Apicultor</option>
        <option value="envasadora">Empresa envasadora</option>
      </select>
    </label>
    <label>
      Tu nombre
      <input id="f-nombre" required autocomplete="name" placeholder="María Ferrer" />
    </label>
    <label id="w-org-apicultor">
      Explotación o colmenar
      <input id="f-org-apicultor" placeholder="Apícola La Rubia" />
    </label>
    <label id="w-org-envasadora" hidden>
      Empresa
      <input id="f-org-envasadora" placeholder="Mieles del Sur S.L." />
    </label>
    <button class="primary" type="submit">Entrar</button>
  </form>
</App>

<script>
  import { getProfile, setProfile } from '../../lib/store';
  import { resumePendingScan, field } from '../../lib/app-ui';

  const existing = getProfile();
  if (existing) {
    resumePendingScan();
    location.href = existing.role === 'apicultor' ? '/app/apicultor' : '/app/envasadora';
  }

  const params = new URLSearchParams(location.search);
  const rol = params.get('rol');
  const rolSel = field<HTMLSelectElement>('f-rol');
  if (rol === 'envasadora' || rol === 'apicultor') rolSel.value = rol;

  const wA = field('w-org-apicultor');
  const wE = field('w-org-envasadora');
  const syncOrg = () => {
    const isApi = rolSel.value === 'apicultor';
    wA.hidden = !isApi;
    wE.hidden = isApi;
  };
  rolSel.addEventListener('change', syncOrg);
  syncOrg();

  field('enter-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const role = rolSel.value as 'apicultor' | 'envasadora';
    const name = (document.getElementById('f-nombre') as HTMLInputElement).value.trim();
    const org =
      role === 'apicultor'
        ? (document.getElementById('f-org-apicultor') as HTMLInputElement).value.trim()
        : (document.getElementById('f-org-envasadora') as HTMLInputElement).value.trim();
    if (!name) return;
    setProfile({ role, name, org: org || (role === 'apicultor' ? 'Mi colmenar' : 'Mi empresa') });
    resumePendingScan();
    location.href = role === 'apicultor' ? '/app/apicultor' : '/app/envasadora';
  });
</script>

<style>
  .sub {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }
</style>
