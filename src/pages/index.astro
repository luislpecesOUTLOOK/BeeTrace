---
import Base from '../layouts/Base.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
import ForBuyers from '../components/ForBuyers.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ScanSection from '../components/ScanSection.astro';
import { content } from '../lib/i18n';

const c = content.es.meta;
---

<Base title={c.title} description={c.description} lang="es">
  <Header lang="es" />
  <main id="main" tabindex="-1">
    <Hero lang="es" />
    <HowItWorks lang="es" />
    <ForBuyers lang="es" />
    <ScanSection lang="es" />
    <ClosingCta lang="es" />
  </main>
  <Footer lang="es" />
</Base>
