---
import Hex from './Hex.astro';
import SectionIntro from './SectionIntro.astro';
import { content, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang].how;
---

<section id="how-it-works" aria-labelledby="how-title">
  <div class="head">
    <SectionIntro eyebrow={c.eyebrow} id="how-title">
      {c.title}
    </SectionIntro>
    <p>{c.lede}</p>
  </div>
  <ol>
    {
      c.steps.map((step, i) => (
        <li>
          <span class="badge">
            <Hex variant="outline" size={52} strokeWidth={1.6} />
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section {
    background: var(--ink);
    padding: 120px 5%;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 64px;
  }

  .head > :first-child {
    flex: 1 1 520px;
    min-width: 0;
  }

  .head > p {
    flex: 1 1 360px;
    min-width: 0;
    max-width: 30em;
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--line);
  }

  .badge {
    position: relative;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    color: var(--accent);
  }

  .badge :global(svg) {
    position: absolute;
    inset: 0;
  }

  .n {
    position: relative;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  li p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
