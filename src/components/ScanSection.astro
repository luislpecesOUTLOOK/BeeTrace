---
import { content, prefix, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang].scan;
const p = prefix(lang);
---

<section class="scan" id="escanear" aria-labelledby="scan-title">
  <div class="head">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2 id="scan-title">{c.title}</h2>
    <p class="lede">{c.lede}</p>
  </div>

  <div class="access" role="list">
    <a class="card" role="listitem" href={`${p}/app/?rol=apicultor`}>
      <strong>{c.cardApi}</strong>
      <span>{c.cardApiSub}</span>
    </a>
    <a class="card" role="listitem" href={`${p}/app/?rol=envasadora`}>
      <strong>{c.cardEnv}</strong>
      <span>{c.cardEnvSub}</span>
    </a>
  </div>

  <div class="panel">
    <div class="actions">
      <button type="button" class="primary" id="scan-open">{c.open}</button>
      <label class="file">
        {c.readFromImage}
        <input type="file" id="scan-file" accept="image/*" hidden />
      </label>
    </div>

    <div class="reader" id="scan-reader" hidden>
      <div class="frame">
        <video id="scan-video" muted playsinline></video>
        <span class="guide" aria-hidden="true"></span>
      </div>
      <canvas id="scan-canvas" hidden></canvas>
      <div class="reader-actions">
        <button type="button" id="scan-switch" hidden>{c.switchCamera}</button>
        <button type="button" id="scan-close">{c.closeScanner}</button>
      </div>
    </div>

    <p class="status" id="scan-status" role="status"></p>

    <form class="manual" id="scan-manual">
      <label for="scan-input">{c.manualLabel}</label>
      <div class="row">
        <input
          id="scan-input"
          name="lote"
          inputmode="text"
          autocomplete="off"
          placeholder="BT-26-0412"
        />
        <button type="submit" class="secondary">{c.consult}</button>
      </div>
    </form>

    <div class="result" id="scan-result" hidden></div>
  </div>
</section>

<script>
  import { QrScanner, decodeImageFile, type ScanState } from '../lib/scanner';
  import { parseScannedText } from '../lib/trace';
  import { getLot, getProfile, setPendingScan } from '../lib/store.ts';
  import { content, docLang, prefix } from '../lib/i18n';

  const lang = docLang();
  const c = content[lang].scan;
  const p = prefix(lang);

  const reader = document.getElementById('scan-reader') as HTMLElement;
  const video = document.getElementById('scan-video') as HTMLVideoElement;
  const canvas = document.getElementById('scan-canvas') as HTMLCanvasElement;
  const status = document.getElementById('scan-status') as HTMLElement;
  const result = document.getElementById('scan-result') as HTMLElement;
  const openBtn = document.getElementById('scan-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('scan-close') as HTMLButtonElement;
  const switchBtn = document.getElementById('scan-switch') as HTMLButtonElement;
  const fileInput = document.getElementById('scan-file') as HTMLInputElement;
  const manual = document.getElementById('scan-manual') as HTMLFormElement;
  const manualInput = document.getElementById('scan-input') as HTMLInputElement;

  const STATE_TEXT: Record<ScanState, string> = {
    idle: '',
    starting: c.states.starting,
    scanning: c.states.scanning,
    denied: c.states.denied,
    'no-camera': c.states.noCamera,
    unsupported: c.states.unsupported,
    insecure: c.states.insecure,
  };

  const scanner = new QrScanner(video, canvas, {
    onText: (text) => handleText(text, true),
    onState: (state, detail) => {
      status.textContent = detail ?? STATE_TEXT[state] ?? '';
      switchBtn.hidden = !scanner.canSwitch();
    },
  });

  function closeReader(): void {
    scanner.stop();
    reader.hidden = true;
    openBtn.textContent = c.open;
  }

  openBtn.addEventListener('click', async () => {
    result.hidden = true;
    if (scanner.active) {
      closeReader();
      return;
    }
    reader.hidden = false;
    openBtn.textContent = c.close;
    await scanner.start();
  });

  closeBtn.addEventListener('click', closeReader);
  switchBtn.addEventListener('click', () => scanner.switchCamera());

  // Stop the camera when leaving the screen or hiding the tab.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) closeReader();
  });
  window.addEventListener('pagehide', () => scanner.stop());

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    status.textContent = c.readingImage;
    try {
      const text = await decodeImageFile(file);
      if (text) handleText(text, false);
      else {
        status.textContent = c.noQrInImage;
        showResult(false, c.noQrTitle, c.noQrBody);
      }
    } catch {
      status.textContent = c.imageUnreadable;
    }
  });

  manual.addEventListener('submit', (e) => {
    e.preventDefault();
    handleText(manualInput.value, false);
  });

  function handleText(raw: string, fromCamera: boolean): void {
    const parsed = parseScannedText(raw);
    if (!parsed.ok) {
      status.textContent = parsed.reason === 'empty' ? c.emptyId : c.foreign;
      showResult(false, c.invalidTitle, c.invalidBody);
      return;
    }
    const lotId = parsed.lotId;
    if (fromCamera) {
      scanner.stop();
      reader.hidden = true;
      openBtn.textContent = c.open;
    }
    const lot = getLot(lotId);
    const profile = getProfile();
    if (!profile) {
      // Keep the identifier and resume the flow after access, checking permissions there.
      setPendingScan(lotId);
      status.textContent = `${c.lotWord} ${lotId} ${c.detected}.`;
      showResult(true, `${lotId}`, lot ? c.loginFound : c.loginNew, [
        { href: `${p}/app/`, label: c.loginTitle },
      ]);
      return;
    }
    status.textContent = `${c.lotWord} ${lotId} ${c.detected}.`;
    showResult(true, lotId, lot ? c.foundBody : c.newBody, [
      { href: `${p}/app/lote?id=${encodeURIComponent(lotId)}`, label: c.openRecord },
    ]);
  }

  function showResult(
    ok: boolean,
    title: string,
    body: string,
    links: { href: string; label: string }[] = [],
  ): void {
    result.hidden = false;
    result.dataset.ok = String(ok);
    result.innerHTML = '';
    const h = document.createElement('p');
    h.className = 'result-title';
    h.textContent = title;
    const pEl = document.createElement('p');
    pEl.textContent = body;
    result.append(h, pEl);
    for (const l of links) {
      const a = document.createElement('a');
      a.href = l.href;
      a.textContent = l.label;
      a.className = 'secondary';
      result.append(a);
    }
    result.scrollIntoView({ block: 'nearest' });
  }
</script>

<style>
  .scan {
    padding: 88px 5%;
    background: var(--band);
    border-top: 1px solid var(--line);
  }

  .head {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 52px);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .lede {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
  }

  .access {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 32px 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    text-decoration: none;
  }

  .card strong {
    font-size: 18px;
  }

  .card span {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .panel {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .primary {
    min-height: 52px;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
    font-size: 17px;
    cursor: pointer;
  }

  .file {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border: 1px solid rgba(245, 239, 227, 0.35);
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
  }

  .reader {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 4 / 3;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .guide {
    position: absolute;
    inset: 18%;
    border: 3px solid var(--accent);
    border-radius: 14px;
    pointer-events: none;
  }

  .reader-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .reader-actions button {
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1px solid rgba(245, 239, 227, 0.35);
    background: transparent;
    color: var(--cream);
    font-size: 16px;
    cursor: pointer;
  }

  .status {
    margin: 0;
    min-height: 24px;
    color: var(--muted);
    font-size: 15px;
  }

  .manual {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .manual label {
    font-size: 15px;
    color: var(--muted);
  }

  .row {
    display: flex;
    gap: 10px;
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid rgba(245, 239, 227, 0.25);
    background: var(--card);
    color: var(--cream);
    font-size: 17px;
    font-family: var(--mono);
  }

  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid rgba(245, 239, 227, 0.35);
    color: var(--cream);
    text-decoration: none;
    font-weight: 600;
    background: transparent;
    cursor: pointer;
    font-size: 16px;
  }

  .result {
    padding: 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--card);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .result[data-ok='true'] {
    border-color: rgba(155, 224, 155, 0.5);
  }

  .result-title {
    margin: 0;
    font-weight: 800;
    font-size: 18px;
  }

  .result p {
    margin: 0;
    color: var(--muted);
  }
</style>
