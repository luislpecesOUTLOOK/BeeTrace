---
import Check from './Check.astro';
import SectionIntro from './SectionIntro.astro';
import { content, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang].buyers;
---

<section id="for-buyers" aria-labelledby="buyers-title">
  <div class="copy">
    <SectionIntro eyebrow={c.eyebrow} id="buyers-title">
      {c.title}
    </SectionIntro>
    <p class="lede">{c.lede}</p>
    <ul>
      {
        c.points.map((point) => (
          <li>
            <Check />
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
    <p class="note">{c.note}</p>
  </div>

  <div class="lookup">
    <label for="lot-code">{c.lookupLabel}</label>
    <div class="field">
      <input id="lot-code" name="lot" placeholder="BT-26-0412" autocomplete="off" spellcheck="false" />
      <button type="button">{c.check}</button>
    </div>
    <div class="result" aria-label="Sample result">
      <div class="result-top">
        <span class="lot">LOT BT-26-0412</span>
        <span class="verified">{content[lang].hero.verified}</span>
      </div>
      <p>{c.sampleText}</p>
      <ul class="proofs">
        {c.proofs.map((proof) => <li>{proof}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--band);
    padding: 120px 5%;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px 80px;
  }

  .copy {
    flex: 1 1 500px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .lede {
    margin: 0;
    max-width: 32em;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }

  .copy ul {
    list-style: none;
    margin: 0;
    padding: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .copy li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 17px;
    line-height: 1.45;
  }

  .copy li :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }

  .note {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--faint);
  }

  .lookup {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: 20px;
    background: var(--ink);
    border: 1px solid rgba(242, 168, 29, 0.28);
  }

  label {
    font-size: 15px;
    font-weight: 700;
  }

  .field {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid rgba(245, 239, 227, 0.25);
    background: var(--card);
    color: var(--cream);
    font-family: var(--mono);
    font-size: 16px;
  }

  input::placeholder {
    color: var(--faint);
  }

  button {
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 12px;
    background: var(--accent);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    border-radius: 14px;
    background: rgba(245, 239, 227, 0.05);
  }

  .result-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .lot {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
  }

  .verified {
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(120, 200, 120, 0.14);
    color: var(--ok);
    font-size: 13px;
    font-weight: 700;
  }

  .result p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  .proofs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .proofs li {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(245, 239, 227, 0.2);
    font-size: 13px;
  }
</style>
