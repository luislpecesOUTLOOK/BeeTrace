---
import LotCard from './LotCard.astro';
import { content, prefix, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang].hero;
const p = prefix(lang);

const lot = {
  lot: c.lot,
  fields: c.fields,
  steps: c.steps,
};

// Long statement headlines need a smaller scale to stay readable.
const longHeadline = (c.titleA + c.titleB).length > 55;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1 id="hero-title" class:list={[{ long: longHeadline }]}>{c.titleA} <span>{c.titleB}</span></h1>
    <p class="lede">{c.lede}</p>
    <div class="actions">
      <a class="primary" href={`${p}/app/?rol=apicultor`}>
        {c.primary}
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="secondary" href="#for-buyers">{c.secondary}</a>
    </div>
    <ol class="journey" aria-label="From apiary to buyer">
      {c.journey.map((stage) => <li>{stage}</li>)}
    </ol>
  </div>

  <div class="card">
    <LotCard {...lot} verified={c.verified} qrNote={c.qrNote} />
  </div>
</section>

<style>
  /* The header above is about 106px tall; together they fill the first screen. */
  .hero {
    min-height: calc(100svh - 106px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px 72px;
    padding: 48px 5% 88px;
  }

  .copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 6.2vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  h1 span {
    color: var(--accent);
  }

  h1.long {
    font-size: clamp(34px, 4.2vw, 62px);
    line-height: 1.04;
  }

  .lede {
    margin: 0;
    max-width: 34em;
    font-size: 20px;
    line-height: 1.5;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 4px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-size: 17px;
    text-decoration: none;
  }

  .primary {
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  .primary:hover {
    color: var(--ink);
    filter: brightness(1.08);
  }

  .secondary {
    border: 1px solid rgba(245, 239, 227, 0.35);
    font-weight: 600;
  }

  .journey {
    list-style: none;
    margin: 0;
    padding: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--faint);
  }

  .journey li + li::before {
    content: '→';
    margin-right: 14px;
    color: var(--accent);
  }

  .card {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 520px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .copy,
    .card {
      flex-basis: 100%;
    }

    .lede {
      font-size: 18px;
    }
  }
</style>
