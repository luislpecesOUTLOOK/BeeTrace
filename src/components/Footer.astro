---
import Brand from './Brand.astro';
import { home, sections } from './nav';
import { content, counterpart, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<footer>
  <Brand size="sm" home={home(lang)} />
  <nav aria-label="Footer">
    {sections(lang).map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="lang" href={counterpart('/', '', lang)} hreflang={other}>
      {other === 'es' ? 'ES' : 'EN'}
    </a>
  </nav>
  <p>{c.footer.rights}</p>
</footer>

<style>
  footer {
    background: var(--ink);
    padding: 40px 5% 56px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    font-size: 15px;
    color: var(--faint);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  nav a {
    text-decoration: none;
    padding: 10px 0;
  }

  nav a.lang {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  p {
    margin: 0;
  }
</style>
