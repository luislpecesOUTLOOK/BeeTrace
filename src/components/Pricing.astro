---
import Check from './Check.astro';
import SectionIntro from './SectionIntro.astro';
import { content, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang].pricing;
---

<section id="pricing" aria-labelledby="pricing-title">
  <div class="head">
    <SectionIntro eyebrow={c.eyebrow} id="pricing-title" align="center">
      {c.title}
    </SectionIntro>
    <p>{c.lede}</p>
  </div>
  <div class="plans">
    {
      c.plans.map((plan, i) => (
        <article class:list={['plan', { featured: i === 1 }]}>
          <div class="plan-top">
            <h3>{plan.name}</h3>
            {i === 1 && <span class="tag">{c.suggested}</span>}
          </div>
          <p class="price">
            <span class="amount">[PRICE]</span>
            <span class="per">{c.per}</span>
          </p>
          <p class="blurb">{plan.blurb}</p>
          <ul>
            {plan.features.map((feature) => (
              <li>
                <Check size={18} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <a class="cta" href="#">
            {plan.cta}
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  section {
    background: var(--ink);
    padding: 120px 5%;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .head > p {
    margin: 0;
    max-width: 34em;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--line);
  }

  .featured {
    background: #241d13;
    border-color: var(--accent);
  }

  .plan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .tag {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .amount {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .per {
    font-size: 15px;
    color: var(--faint);
  }

  .blurb {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid rgba(245, 239, 227, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.4;
  }

  li :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid rgba(245, 239, 227, 0.35);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }

  .featured .cta {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  .featured .cta:hover {
    filter: brightness(1.08);
  }
</style>
