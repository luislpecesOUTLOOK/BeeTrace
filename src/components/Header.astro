---
import Brand from './Brand.astro';
import { home, sections } from './nav';
import { content, counterpart, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = content[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<header>
  <Brand home={home(lang)} />
  <nav aria-label="Main">
    {sections(lang).map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="lang" href={counterpart('/', '', lang)} hreflang={other} aria-label={c.header.langName}>
      {other === 'es' ? 'ES' : 'EN'}
    </a>
    <a class="signin" href={`${home(lang)}app/`}>{c.header.login}</a>
  </nav>
</header>

<style>
  header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 28px 5%;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    font-size: 16px;
  }

  nav a {
    text-decoration: none;
    padding: 10px 0;
  }

  nav .signin {
    padding: 10px 18px;
    border: 1px solid rgba(245, 239, 227, 0.28);
    border-radius: 999px;
  }

  nav .lang {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
</style>
