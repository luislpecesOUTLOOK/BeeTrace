---
import App from '../../layouts/App.astro';
import { content, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const e = content[lang].enter;
---

<App title="Entrar · BeeTrace" lang={lang}>
  <h1>{e.title}</h1>
  <p class="sub">{e.sub}</p>

  <form id="enter-form">
    <label>
      {e.rol}
      <select id="f-rol" required>
        <option value="apicultor">{e.apicultor}</option>
        <option value="envasadora">{e.envasadora}</option>
      </select>
    </label>
    <label>
      {e.nombre}
      <input id="f-nombre" required autocomplete="name" placeholder={e.nombrePh} />
    </label>
    <label id="w-org-apicultor">
      {e.orgA}
      <input id="f-org-apicultor" placeholder={e.orgAPh} />
    </label>
    <label id="w-org-envasadora" hidden>
      {e.orgE}
      <input id="f-org-envasadora" placeholder={e.orgEPh} />
    </label>
    <button class="primary" type="submit">{e.entrar}</button>
  </form>
</App>

<script>
  import { getProfile, setProfile } from '../../lib/store.ts';
  import { resumePendingScan, field } from '../../lib/app-ui';
  import { content, docLang, prefix } from '../../lib/i18n';

  const lang = docLang();
  const e = content[lang].enter;
  const P = prefix(lang);

  const existing = getProfile();
  if (existing) {
    resumePendingScan();
    location.href =
      existing.role === 'apicultor' ? `${P}/app/apicultor` : `${P}/app/envasadora`;
  }

  const params = new URLSearchParams(location.search);
  const rol = params.get('rol');
  const rolSel = field<HTMLSelectElement>('f-rol');
  if (rol === 'envasadora' || rol === 'apicultor') rolSel.value = rol;

  const wA = field('w-org-apicultor');
  const wE = field('w-org-envasadora');
  const syncOrg = () => {
    const isApi = rolSel.value === 'apicultor';
    wA.hidden = !isApi;
    wE.hidden = isApi;
  };
  rolSel.addEventListener('change', syncOrg);
  syncOrg();

  field('enter-form').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const role = rolSel.value as 'apicultor' | 'envasadora';
    const name = (document.getElementById('f-nombre') as HTMLInputElement).value.trim();
    const org =
      role === 'apicultor'
        ? (document.getElementById('f-org-apicultor') as HTMLInputElement).value.trim()
        : (document.getElementById('f-org-envasadora') as HTMLInputElement).value.trim();
    if (!name) return;
    setProfile({
      role,
      name,
      org: org || (role === 'apicultor' ? e.defaultOrgA : e.defaultOrgE),
    });
    resumePendingScan();
    location.href = role === 'apicultor' ? `${P}/app/apicultor` : `${P}/app/envasadora`;
  });
</script>

<style>
  .sub {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }
</style>
