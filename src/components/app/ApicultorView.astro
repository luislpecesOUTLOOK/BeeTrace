---
import App from '../../layouts/App.astro';
import { content, prefix, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const a = content[lang].api;
const p = prefix(lang);
---

<App title="Apicultor · BeeTrace" lang={lang}>
  <div class="who">
    <h1>{a.title}</h1>
    <p id="who-line" class="who-line"></p>
    <div class="who-actions">
      <a class="ghost" href={`${p}/#escanear`}>{a.scan}</a>
      <button class="ghost" id="btn-out" type="button">{a.salir}</button>
    </div>
  </div>

  <ul class="card-list" id="lot-list"></ul>

  <h2>{a.createTitle}</h2>
  <p class="hint" id="create-hint">{a.createHint}</p>
  <form id="lot-form">
    <label>
      {a.fId}
      <input id="f-id" placeholder="BT-26-0413" />
    </label>
    <label>
      {a.fBeekeeper}
      <input id="f-beekeeper" required />
    </label>
    <label>
      {a.fFarm}
      <input id="f-farm" required />
    </label>
    <div class="grid">
      <label>
        {a.fCountry}
        <input id="f-country" required placeholder={a.fCountryPh} />
      </label>
      <label>
        {a.fLocation}
        <input id="f-location" required placeholder={a.fLocationPh} />
      </label>
    </div>
    <div class="grid">
      <label>
        {a.fHarvest}
        <input id="f-harvest" type="date" required />
      </label>
      <label>
        {a.fExtraction}
        <input id="f-extraction" type="date" required />
      </label>
    </div>
    <div class="grid">
      <label>
        {a.fType}
        <input id="f-type" required placeholder={a.fTypePh} />
      </label>
      <label>
        {a.fKg}
        <input id="f-kg" type="number" min="0.1" step="0.1" required placeholder="240" />
      </label>
    </div>

    <fieldset>
      <legend>{a.drumsLegend}</legend>
      <div id="drums"></div>
      <button class="ghost" id="btn-drum" type="button">{a.addDrum}</button>
      <p class="hint" id="drums-hint"></p>
    </fieldset>

    <label>
      {a.fDocs}
      <textarea id="f-docs" placeholder={a.fDocsPh}></textarea>
    </label>
    <div class="grid">
      <label>
        {a.fDest}
        <input id="f-dest" placeholder={content[lang].enter.orgEPh} />
      </label>
      <label>
        {a.fShip}
        <input id="f-ship" type="date" />
      </label>
    </div>
    <button class="primary" id="btn-save" type="submit">{a.save}</button>
  </form>

  <h2>{a.history}</h2>
  <ul class="card-list" id="mov-list"></ul>
</App>

<script>
  import {
    createLot,
    getProfile,
    listLots,
    listMovements,
    setStoreLang,
    type Profile,
  } from '../../lib/store.ts';
  import { drumsMatchTotal, isValidDrumId } from '../../lib/trace.ts';
  import { flash, num, requireProfile, signOut, today, val, field } from '../../lib/app-ui';
  import { content, docLang, prefix } from '../../lib/i18n';

  const lang = docLang();
  setStoreLang(lang);
  const a = content[lang].api;
  const P = prefix(lang);

  const profile = requireProfile('apicultor') as Profile | null;
  if (profile) {
    field('who-line').textContent = `${profile.name} · ${profile.org}`;
    (document.getElementById('f-beekeeper') as HTMLInputElement).value = profile.name;
    (document.getElementById('f-farm') as HTMLInputElement).value = profile.org;
    (document.getElementById('f-harvest') as HTMLInputElement).value = today();
    (document.getElementById('f-extraction') as HTMLInputElement).value = today();

    const params = new URLSearchParams(location.search);
    const preset = params.get('crear') ?? params.get('id');
    if (preset) {
      (document.getElementById('f-id') as HTMLInputElement).value = preset.toUpperCase();
      field('create-hint').innerHTML = '';
      const strong = document.createElement('strong');
      strong.textContent = preset.toUpperCase();
      field('create-hint').append(strong, ` ${a.createHintScan}`);
    }

    renderLots();
    renderMovements();
  }

  field('btn-out').addEventListener('click', signOut);

  function renderLots(): void {
    const ul = field('lot-list');
    ul.innerHTML = '';
    const lots = listLots();
    if (lots.length === 0) {
      const li = document.createElement('li');
      li.className = 'lot-card';
      const span = document.createElement('span');
      span.textContent = a.empty;
      li.append(span);
      ul.append(li);
      return;
    }
    for (const l of lots) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.className = 'lot-card';
      link.href = `${P}/app/lote?id=${encodeURIComponent(l.id)}`;
      const demo = l.demo ? ` · ${a.demo}` : '';
      const kind = l.kind === 'mezcla' ? a.kindMezcla : a.kindOrigen;
      link.innerHTML = '';
      const strong = document.createElement('strong');
      strong.textContent = l.id;
      const span = document.createElement('span');
      span.textContent = `${l.honeyType} · ${l.totalKg} kg · ${l.farm}${demo}`;
      const pill = document.createElement('span');
      pill.className = 'pill';
      pill.textContent = `${kind} · ${l.receptionStatus}`;
      link.append(strong, span, pill);
      li.append(link);
      ul.append(li);
    }
  }

  function renderMovements(): void {
    const ul = field('mov-list');
    ul.innerHTML = '';
    for (const m of listMovements(20)) {
      const li = document.createElement('li');
      li.className = 'lot-card';
      const strong = document.createElement('strong');
      strong.textContent = m.action;
      const s1 = document.createElement('span');
      s1.textContent = `${m.actor} · ${new Date(m.at).toLocaleString(lang === 'en' ? 'en' : 'es')}`;
      const s2 = document.createElement('span');
      s2.textContent = m.detail;
      li.append(strong, s1, s2);
      ul.append(li);
    }
  }

  interface DrumRow {
    id: HTMLInputElement;
    kg: HTMLInputElement;
  }
  const rows: DrumRow[] = [];

  function addDrum(id = '', kg = ''): void {
    const wrap = document.createElement('div');
    wrap.className = 'drum-row';
    const idEl = document.createElement('input');
    idEl.placeholder = a.drumIdPh;
    idEl.setAttribute('aria-label', a.drumsLegend);
    const kgEl = document.createElement('input');
    kgEl.type = 'number';
    kgEl.min = '0.1';
    kgEl.step = '0.1';
    kgEl.placeholder = a.drumKgPh;
    const rm = document.createElement('button');
    rm.type = 'button';
    rm.setAttribute('aria-label', a.removeDrum);
    rm.textContent = '✕';
    idEl.value = id;
    kgEl.value = kg;
    const row = { id: idEl, kg: kgEl };
    rows.push(row);
    rm.addEventListener('click', () => {
      wrap.remove();
      rows.splice(rows.indexOf(row), 1);
      syncDrumsHint();
    });
    kgEl.addEventListener('input', syncDrumsHint);
    wrap.append(idEl, kgEl, rm);
    field('drums').append(wrap);
    syncDrumsHint();
  }

  function syncDrumsHint(): void {
    const total = num('f-kg');
    const sum = rows.reduce((acc, r) => acc + (Number(r.kg.value.replace(',', '.')) || 0), 0);
    field('drums-hint').textContent =
      rows.length === 0
        ? a.drumsEmpty
        : `${a.drumsSum}: ${Math.round(sum * 100) / 100} kg / ${a.drumsTotal}: ${total || 0} kg.`;
  }

  field('f-kg').addEventListener('input', syncDrumsHint);
  field('btn-drum').addEventListener('click', () => addDrum());
  addDrum();

  field('lot-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!profile) return;
    const btn = field<HTMLButtonElement>('btn-save');
    btn.disabled = true;
    try {
      const totalKg = num('f-kg');
      if (!(totalKg > 0)) throw new Error(a.errKg);
      const drums = rows
        .filter((r) => r.id.value.trim() || r.kg.value.trim())
        .map((r) => ({
          id: r.id.value.trim(),
          weightKg: Number(r.kg.value.replace(',', '.')),
        }));
      if (drums.length === 0) throw new Error(a.errDrumRequired);
      for (const d of drums) {
        if (!isValidDrumId(d.id)) throw new Error(`${a.errDrumId}: ${d.id}.`);
        if (!(d.weightKg > 0)) throw new Error(`${a.errDrumWeight} ${d.id}.`);
      }
      const seen = new Set(drums.map((d) => d.id));
      if (seen.size !== drums.length) throw new Error(a.errDrumDup);
      if (!drumsMatchTotal(drums, totalKg)) throw new Error(a.errDrumMismatch);
      const rawId = val('f-id');
      const docs = val('f-docs')
        .split('\n')
        .map((s) => s.trim())
        .filter(Boolean)
        .map((name) => ({ name }));
      const lot = createLot(
        {
          id: rawId || undefined,
          beekeeper: val('f-beekeeper'),
          farm: val('f-farm'),
          country: val('f-country'),
          location: val('f-location'),
          harvestDate: val('f-harvest'),
          extractionDate: val('f-extraction'),
          honeyType: val('f-type'),
          totalKg,
          drums,
          docs,
          destCompany: val('f-dest'),
          shipDate: val('f-ship'),
        },
        profile,
      );
      flash('ok', `${lot.id}: ${a.saved}`);
      location.href = `${P}/app/lote?id=${encodeURIComponent(lot.id)}`;
    } catch (err) {
      flash('error', err instanceof Error ? err.message : a.errSave);
      btn.disabled = false;
    }
  });
</script>

<style>
  .who-line {
    color: var(--muted);
    margin: 4px 0 12px;
  }

  .who-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
  }

  .hint {
    color: var(--muted);
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  fieldset {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  legend {
    padding: 0 8px;
    color: var(--muted);
  }

  .drum-row {
    display: grid;
    grid-template-columns: 1fr 110px 52px;
    gap: 8px;
  }

  .drum-row button {
    min-height: 52px;
    border-radius: 12px;
    border: 1px solid rgba(245, 239, 227, 0.25);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    font-size: 18px;
  }
</style>
